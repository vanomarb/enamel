{
  "name": "enamel",
  "version": "1.0.0",
  "description": "Enamel, a concept family dental clinic in Guadalupe, Cebu City: a twelve-page website with prices up front, a tooth explorer and a booking stepper.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "node --test \"app/**/*.test.ts\" \"build/**/*.test.ts\" \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1"
  }
}
